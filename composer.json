{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "artesaos/seotools": "^1.1.0",
        "geoip2/geoip2": "^2.12",
        "guzzlehttp/guzzle": "^7.0.1",
        "inertiajs/inertia-laravel": "^3.3",
        "io-developer/php-whois": "^4.1",
        "jenssegers/agent": "^2.6",
        "joedixon/laravel-translation": "^1.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.19.0",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "league/commonmark": "^2.7",
        "mews/purifier": "^3.3",
        "mollie/laravel-mollie": "^3.0",
        "monolog/monolog": "^3.0",
        "openai-php/client": "^0.17.1",
        "orhanerday/open-ai": "^3.5",
        "paypal/paypal-checkout-sdk": "^1.0",
        "phpunit/phpunit": "^11.5",
        "protonemedia/laravel-verify-new-email": "^1.6",
        "rachidlaasri/laravel-installer": "^4.1",
        "rappasoft/laravel-authentication-log": "^6.0",
        "razorpay/razorpay": "2.*",
        "smalot/pdfparser": "^2.11",
        "spatie/color": "^1.5",
        "spatie/laravel-cookie-consent": "^3.2",
        "spatie/laravel-responsecache": "^7.5",
        "spatie/laravel-sitemap": "^7.3",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^7.91",
        "symfony/dom-crawler": "^7.1",
        "tightenco/ziggy": "^2.6",
        "torann/geoip": "^3.0",
        "yajra/laravel-datatables-oracle": "12.0"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Plugins\\": "plugins/",
            "Storage\\App\\Public\\": "storage/app/public/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "app/Helpers/DateHelper.php"
        ],
        "classmap": [
            "app/Classes",
            "storage/app/public"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "audit": {
            "abandoned": "ignore"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
